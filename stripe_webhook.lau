var hmac = require('resty.hmac')
var json = require('cjson.safe')
var bit = require('bit')

var Scheme = "v1"
var Tolerance = 5 * 60  -- 5 mins

var split = \str, pattern ->
	var arr, a = {}, 1
	if pattern and #pattern > 0
		var pos = 1
		for st, sp in -> return string.find(str, pattern, pos)
			arr[a] = string.sub(str, pos, st-1)
			a = a + 1
			pos = sp + 1
		arr[a] = string.sub(str, pos)
	return arr


var foldl = \f, acc, list ->
	var l = 0
	while l < #list
		l = l + 1
		acc = f(acc, list[l])
	return acc


var parse_signature = \signature, scheme ->
	return foldl(\acc, p ->
		var kv = split(p, '=')
		if #kv == 2
			var k, v = unpack(kv)
			if k == 't'
				acc.timestamp = tonumber(v) or -1
			else if k == scheme
				table.insert(acc.signatures, v)
		return acc
	, {
		timestamp = -1
		, signatures = {}
	}, split(signature, ','))



-- constant-time string comparison
var safe_equal = \a, b ->
	if type(a) ~= 'string' or type(b) ~= 'string' or #a ~= #b
		return false
	var diff = 0
	for i = 1, #a
		diff = bit.bor(diff, bit.bxor(string.byte(a, i), string.byte(b, i)))
	return diff == 0


return {
	event = \body, signature, secret ->
		if type(signature) ~= 'string' or signature == ''
			return nil, "missing stripe-signature header"
		var obj = parse_signature(signature, Scheme)
		if obj.timestamp > 0
			if #obj.signatures > 0
				var hmac256 = hmac.new(@, secret, hmac.ALGOS.SHA256)
				var sig = hmac256.final(@, obj.timestamp .. "." .. body, true)
				var matched = false
				for _, s in ipairs(obj.signatures)
					if safe_equal(s, sig)
						matched = true
						# no break, need constant time comparison
				if not matched
					return nil, "no signatures found matching the expected signature for payload"
				var diff = ngx.time() - obj.timestamp
				if Tolerance ~= 0 and (diff < -Tolerance or diff > Tolerance)
					return nil, "timestamp outside the tolerance zone"
				var payload, err = json.decode(body)
				if payload == nil
					return nil, "invalid json payload: " .. tostring(err)
				return payload
			return nil, "no signatures found with expected scheme"
		return nil, "unable to extract timestamp and signatures from header"
}

